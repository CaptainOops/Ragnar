{
  "id": "monitor_logs",
  "name": "Monitor Logs",
  "description": "Enable terminal logging and tail console output in real time.",
  "vendor": "cisco",
  "commands": [
    {
      "cmd": "",
      "delay": 0.5
    },
    {
      "cmd": "enable",
      "delay": 1
    },
    {
      "cmd": "terminal monitor",
      "delay": 0.5
    },
    {
      "cmd": "terminal length 0",
      "delay": 0.5
    },
    {
      "cmd": "show logging last 50",
      "delay": 2
    }
  ]
}
